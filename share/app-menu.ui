<?xml version="1.0"?>
<interface domain="bleachbit">
  <menu id="app-menu">
    <section>
      <item>
        <attribute name="action">app.preferences</attribute>
        <!-- TRANSLATORS: This menu item opens a dialog where the user can
        configure application settings. -->
        <attribute name="label" translatable="yes">Preferences</attribute>
      </item>
    </section>
    <section>
      <!-- TRANSLATORS: Label of the submenu holding the less frequently used
      tools (secure deletion and disk space wiping). Keeping them in a submenu
      keeps the main menu short. -->
      <submenu>
        <attribute name="label" translatable="yes">Advanced tools</attribute>
        <section>
          <item>
            <attribute name="action">app.shredFiles</attribute>
            <!-- TRANSLATORS: This menu item opens a file picker dialog where the
            user can select one or more files. The selected files are then
            securely deleted by overwriting their data before removal, making
            recovery impossible. "Shredding" refers to this secure deletion process. -->
            <attribute name="label" translatable="yes">_Shred Files</attribute>
          </item>
          <item>
            <attribute name="action">app.shredFolders</attribute>
            <!-- TRANSLATORS: This menu item prompts the user to select one or
            more folders using a folder picker dialog. Then, it securely deletes
            the selected folder(s) and all their contents. "Shredding" means
            overwriting data before deletion to prevent recovery. -->
            <attribute name="label" translatable="yes">Sh_red Folders</attribute>
          </item>
          <item>
            <attribute name="action">app.shredClipboard</attribute>
            <!-- TRANSLATORS: This menu item reads file or folder paths from the
            clipboard, then securely deletes them. "Shredding" means overwriting
            data before deletion to prevent recovery. The clipboard is cleared
            after the operation. -->
            <attribute name="label" translatable="yes">Shred Paths from Clipboard</attribute>
            <attribute name="accel">&lt;Control&gt;v</attribute>
          </item>
          <item>
            <attribute name="action">app.wipeEmptySpace</attribute>
            <!-- TRANSLATORS: This menu item prompts the user to select a folder.
            It then fills the partition with data until full, overwriting any
            recoverable traces of previously deleted files. "Empty space" refers
            to unallocated disk space where deleted file data may still exist. -->
            <attribute name="label" translatable="yes">_Wipe Empty Space</attribute>
          </item>
          <item>
            <attribute name="action">app.shredQuit</attribute>
            <!-- TRANSLATORS: This menu item securely deletes the application's
            configuration files (resetting all settings to defaults) and then
            closes the application. "Shredding" means overwriting data before
            deletion to prevent recovery. -->
            <attribute name="label" translatable="yes">S_hred Settings and Quit</attribute>
          </item>
        </section>
      </submenu>
    </section>
    <section>
      <item>
        <attribute name="action">app.about</attribute>
        <!-- TRANSLATORS: This menu item opens a dialog with general information
        about the application, including its name, version, description,
        copyright, license, and website link. -->
        <attribute name="label" translatable="yes">_About PurgeBit</attribute>
      </item>
    </section>
  </menu>
</interface>
